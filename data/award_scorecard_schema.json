{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyy-yuichi.github.io/yamaguchi-yusho-data/data/award_scorecard_schema.json",
  "title": "UDC2026 evidence-based award comparison scorecard",
  "description": "UDC2026の公式3観点を、公式配点ではない共通内部尺度で比較するための形式。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scorecard_id",
    "work_id",
    "work_title",
    "evaluation_as_of",
    "evidence_boundary",
    "official_source",
    "classification",
    "scoring_method",
    "criteria",
    "overall",
    "special_awards",
    "top_improvements",
    "links"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scorecard_id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "work_title": { "type": "string", "minLength": 1 },
    "evaluation_as_of": { "$ref": "#/$defs/date" },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "other_work_input_count", "policy", "decision_owner"],
      "properties": {
        "repository_id": { "type": "string", "minLength": 1 },
        "other_work_input_count": { "const": 0 },
        "policy": { "type": "string", "minLength": 1 },
        "decision_owner": { "const": "human" }
      }
    },
    "official_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "page_updated_at", "verified_at", "numeric_weights_published"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "page_updated_at": { "$ref": "#/$defs/date" },
        "verified_at": { "$ref": "#/$defs/date" },
        "numeric_weights_published": { "const": false }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_type", "theme", "priority_field", "priority_treatment"],
      "properties": {
        "work_type": { "const": "アプリケーション" },
        "theme": { "const": "道路・交通" },
        "priority_field": { "const": true },
        "priority_treatment": { "type": "string", "minLength": 1 }
      }
    },
    "scoring_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_min", "scale_max", "step", "criterion_rounding", "overall_formula", "official_score", "warning"],
      "properties": {
        "scale_min": { "const": 0.0 },
        "scale_max": { "const": 5.0 },
        "step": { "const": 0.5 },
        "criterion_rounding": { "const": "nearest_0.5_half_up" },
        "overall_formula": { "const": "mean(criteria.score) / 5 * 100" },
        "official_score": { "const": false },
        "warning": { "type": "string", "minLength": 1 }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_index", "max_index", "confidence", "interpretation"],
      "properties": {
        "comparison_index": { "type": "number", "minimum": 0, "maximum": 100 },
        "max_index": { "const": 100.0 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "interpretation": { "type": "string", "minLength": 1 }
      }
    },
    "special_awards": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/special_award" }
    },
    "top_improvements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/improvement" }
    },
    "links": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/url" }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "url": { "type": "string", "pattern": "^https://" },
    "score": { "type": "number", "minimum": 0, "maximum": 5, "multipleOf": 0.5 },
    "confidence": { "enum": ["high", "medium", "low"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "url", "evidence_type", "as_of"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "evidence_type": { "enum": ["official_rule", "public_demo", "public_data", "public_verification", "source_code"] },
        "as_of": { "$ref": "#/$defs/date" }
      }
    },
    "subcriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subcriterion_id", "label", "score", "confidence", "rationale", "evidence", "missing_evidence", "as_of"],
      "properties": {
        "subcriterion_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "score": { "$ref": "#/$defs/score" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "missing_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "as_of": { "$ref": "#/$defs/date" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "label", "official_definition", "official_weight", "comparison_weight", "score", "confidence", "rationale", "evidence", "missing_evidence", "as_of", "subcriteria"],
      "properties": {
        "criterion_id": { "enum": ["utility", "completeness", "challenge"] },
        "label": { "enum": ["実用度", "完成度", "挑戦度"] },
        "official_definition": { "type": "string", "minLength": 1 },
        "official_weight": { "type": "null" },
        "comparison_weight": { "const": 0.3333333333333333 },
        "score": { "$ref": "#/$defs/score" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "missing_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "as_of": { "$ref": "#/$defs/date" },
        "subcriteria": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "#/$defs/subcriterion" } }
      }
    },
    "special_award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["award_id", "label", "status", "condition", "rationale", "evidence", "next_gate"],
      "properties": {
        "award_id": { "enum": ["gtfs", "bodik", "datakids", "jacic"] },
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["eligible", "condition_unmet", "not_claimed", "not_listed_2026"] },
        "condition": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "next_gate": { "type": "string", "minLength": 1 }
      }
    },
    "improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "improvement_id", "title", "why", "target_subcriteria", "expected_index_gain_range", "effort", "external_dependency", "acceptance_evidence"],
      "properties": {
        "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
        "improvement_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "target_subcriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "expected_index_gain_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "effort": { "enum": ["small", "medium", "large"] },
        "external_dependency": { "type": "boolean" },
        "acceptance_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

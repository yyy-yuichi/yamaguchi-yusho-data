  "gap_types": [
    {
      "code": "information_gap",
      "definition": "必要な事実を裏づける原本が、受入済み7原本に含まれていない状態。",
      "allowed_conclusion": "追加原本候補の検討が必要。",
      "prohibited_conclusion": "情報対象または交通サービスが存在しない。"
    },
    {
      "code": "measurement_gap",
      "definition": "受入済み原本に必要な列・表があるが、現在の派生データまたは公開画面で未集計・未表示の状態。",
      "allowed_conclusion": "新原本を採用せずに抽出・測定・表示できる可能性がある。",
      "prohibited_conclusion": "原本に情報がない。"
    },
    {
      "code": "service_gap",
      "definition": "現実の交通サービスが住民の移動目的、時間、条件、需要に対して不足している状態。",
      "allowed_conclusion": "供給情報を需要・活動機会・実運行と比較した後にだけ検討できる。",
      "prohibited_conclusion": "登録0件、GTFS未確認、予定便数、原本不足だけから交通不足を断定する。"
    }
  ],
  "status_vocabulary": [
